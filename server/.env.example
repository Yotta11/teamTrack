# Copier en .env pour le développement local
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://teamtrack:teamtrack@localhost:5432/teamtrack
TEST_DATABASE_URL=postgres://teamtrack:teamtrack@localhost:5432/teamtrack_test
# Générer une valeur longue et aléatoire : openssl rand -hex 48
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# SMTP facultatif : sans SMTP, les e-mails sont affichés dans la console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TeamTrack <no-reply@votre-domaine.com>
SCHEDULER_ENABLED=true
API_RATE_LIMIT=1500
