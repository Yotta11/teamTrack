# Variables pour docker compose (ne jamais versionner le fichier .env)
POSTGRES_DB=teamtrack
POSTGRES_USER=teamtrack
POSTGRES_PASSWORD=change-me-strong-password
# openssl rand -hex 48
JWT_SECRET=change-me
APP_URL=http://localhost:8080
WEB_PORT=8080
# Afficher les comptes de démonstration sur l'écran de connexion (true en préproduction)
VITE_SHOW_DEMO=false
# Images publiées par la CI (GitHub Container Registry)
REGISTRY=ghcr.io/votre-organisation
TAG=latest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TeamTrack <no-reply@votre-domaine.com>
